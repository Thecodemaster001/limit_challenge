# Copy to .env and adjust as needed.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://submissions:submissions@localhost:5432/submissions

# Trusted origin of the Next.js app, which proxies /api to Django.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Auth cookies are only sent over HTTPS when true; defaults to the opposite of DEBUG.
# AUTH_COOKIE_SECURE=False

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
